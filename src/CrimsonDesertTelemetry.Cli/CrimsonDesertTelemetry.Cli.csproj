<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <AssemblyName>crimson-desert-telemetry</AssemblyName>
    <RootNamespace>CrimsonDesertTelemetry.Cli</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../CrimsonDesertTelemetry.Core/CrimsonDesertTelemetry.Core.csproj" />
    <Content Include="../../definitions/*.json" Link="definitions/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../schema/*.json" Link="schema/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <EmbeddedResource Include="../../schema/telemetry-v1.schema.json" Link="schema/telemetry-v1.schema.json" />
    <EmbeddedResource Include="../../schema/ambient-v1.schema.json" Link="schema/ambient-v1.schema.json" />
    <EmbeddedResource Include="../../schema/activity-v1.schema.json" Link="schema/activity-v1.schema.json" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
</Project>
