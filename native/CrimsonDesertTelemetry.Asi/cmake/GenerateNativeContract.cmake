# The JSON definition is the only editable reference/offset source. Production
# contracts with full Support metadata also permit guarded runtime recovery.
# Old build packages remain reproducible with
# -DCDT_NATIVE_BUILD_ID=<id> while the default follows the current product build.
set(CDT_NATIVE_BUILD_ID "26423880" CACHE STRING "Reference Steam build contract compiled into this ASI")
option(CDT_ALLOW_RESEARCH_NATIVE "Explicit private test of an unvalidated exact-build contract" OFF)
set(CDT_NATIVE_DEFINITION "${CDT_ROOT}/definitions/build-${CDT_NATIVE_BUILD_ID}.json")
if(NOT EXISTS "${CDT_NATIVE_DEFINITION}")
    message(FATAL_ERROR "Native contract definition does not exist: ${CDT_NATIVE_DEFINITION}")
endif()
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${CDT_NATIVE_DEFINITION}")
file(READ "${CDT_NATIVE_DEFINITION}" cdt_profile)

function(cdt_require out type)
    string(JSON actual_type ERROR_VARIABLE error TYPE "${cdt_profile}" ${ARGN})
    if(error OR NOT actual_type STREQUAL "${type}")
        message(FATAL_ERROR "Native contract ${ARGN}: required ${type} field missing or malformed (${error})")
    endif()
    string(JSON value GET "${cdt_profile}" ${ARGN})
    set(${out} "${value}" PARENT_SCOPE)
endfunction()
function(cdt_number out)
    cdt_require(value NUMBER ${ARGN})
    if(NOT value MATCHES "^[0-9]+$" OR value GREATER 2147483647)
        message(FATAL_ERROR "Native contract ${ARGN}: bounded unsigned integer required")
    endif()
    set(${out} "${value}" PARENT_SCOPE)
endfunction()
function(cdt_bytes out size_out text)
    string(REGEX REPLACE "[ \t\r\n]" "" compact "${text}")
    string(LENGTH "${compact}" length)
    math(EXPR remainder "${length} % 2")
    if(NOT compact MATCHES "^[0-9A-Fa-f]+$" OR remainder OR length GREATER 256)
        message(FATAL_ERROR "Native contract exact signature must contain 1..128 complete hex bytes (no wildcards)")
    endif()
    math(EXPR count "${length} / 2")
    string(REGEX REPLACE "(..)" "0x\\1," result "${compact}")
    set(${out} "${result}" PARENT_SCOPE)
    set(${size_out} "${count}" PARENT_SCOPE)
endfunction()

cdt_number(CDT_SCHEMA schemaVersion)
cdt_number(CDT_NATIVE_SCHEMA nativeCapture schemaVersion)
cdt_require(CDT_BUILD STRING steamBuildId)
cdt_require(CDT_CONTRACT_ID STRING nativeCapture contractId)
cdt_require(status STRING status)
cdt_require(native_status STRING nativeCapture status)
cdt_require(exact BOOLEAN nativeCapture requiresExactExecutable)
set(expected_contract_id "manylights-filter-${CDT_BUILD}-v1")
set(CDT_RESEARCH_CONTRACT false)
if(status STREQUAL "research" AND native_status STREQUAL "research")
    if(NOT CDT_ALLOW_RESEARCH_NATIVE)
        message(FATAL_ERROR "Research native contract requires explicit CDT_ALLOW_RESEARCH_NATIVE=ON")
    endif()
    set(CDT_RESEARCH_CONTRACT true)
    message(WARNING "PRIVATE UNVALIDATED NATIVE DIAGNOSTIC: not a supported or releasable build")
elseif(NOT status STREQUAL "locally-validated" OR NOT native_status STREQUAL "locally-validated")
    message(FATAL_ERROR "Native and product validation statuses disagree")
elseif(CDT_ALLOW_RESEARCH_NATIVE)
    message(FATAL_ERROR "Do not enable the research-native bypass for a validated contract")
endif()
if(NOT CDT_SCHEMA EQUAL 1 OR NOT CDT_NATIVE_SCHEMA EQUAL 1 OR
   NOT exact OR
   NOT CDT_BUILD STREQUAL CDT_NATIVE_BUILD_ID OR NOT CDT_CONTRACT_ID STREQUAL expected_contract_id)
    message(FATAL_ERROR "Native contract is not a coherent exact-executable contract")
endif()
cdt_require(hash STRING executableSha256)
string(LENGTH "${hash}" hash_length)
if(NOT hash_length EQUAL 64 OR NOT hash MATCHES "^[0-9A-Fa-f]+$")
    message(FATAL_ERROR "Native contract executableSha256 must contain exactly 32 bytes")
endif()
string(REGEX REPLACE "(..)" "0x\\1," CDT_EXE_HASH "${hash}")
cdt_number(CDT_SCENE_GLOBAL engineLights sceneGlobalRva)
cdt_number(camera_global engineCamera cameraGlobalRva)
if(CDT_SCENE_GLOBAL EQUAL 0 OR NOT CDT_SCENE_GLOBAL EQUAL camera_global)
    message(FATAL_ERROR "Native and managed scene roots disagree")
endif()
cdt_number(CDT_HOOK_RVA nativeCapture hookRva)
if(CDT_BUILD STREQUAL "25116796")
    # Preserve the archived native build's old default; its ambient path was
    # never part of this update's full-product recovery.
    set(CDT_SKY_PRODUCER_RVA 59030903)
else()
    cdt_number(CDT_SKY_PRODUCER_RVA nativeCapture skyProducerRva)
endif()
cdt_require(hook STRING nativeCapture hookSignature)
cdt_bytes(CDT_HOOK_BYTES CDT_HOOK_SIZE "${hook}")
if(NOT CDT_HOOK_SIZE EQUAL 25)
    message(FATAL_ERROR "The current thunk contract requires the validated 25-byte hook signature")
endif()
foreach(pair "output;r12" "command;rbx" "counter;r15" "owner;r13")
    list(GET pair 0 name)
    list(GET pair 1 expected)
    cdt_require(actual STRING nativeCapture registers ${name})
    if(NOT actual STREQUAL expected)
        message(FATAL_ERROR "Native ${name} register differs from the reviewed assembly thunk")
    endif()
endforeach()

cdt_require(contexts ARRAY nativeCapture contextSignatures)
string(JSON CDT_CONTEXT_COUNT LENGTH "${contexts}")
if(CDT_CONTEXT_COUNT LESS 1 OR CDT_CONTEXT_COUNT GREATER 8)
    message(FATAL_ERROR "Native contract requires 1..8 bounded provenance signatures")
endif()
set(CDT_CONTEXT_ARRAYS "")
set(CDT_CONTEXT_ENTRIES "")
math(EXPR last_context "${CDT_CONTEXT_COUNT} - 1")
foreach(index RANGE 0 ${last_context})
    cdt_number(rva nativeCapture contextSignatures ${index} rva)
    cdt_require(bytes STRING nativeCapture contextSignatures ${index} bytes)
    cdt_require(purpose STRING nativeCapture contextSignatures ${index} purpose)
    cdt_bytes(values length "${bytes}")
    if(rva EQUAL 0 OR length LESS 8 OR purpose STREQUAL "")
        message(FATAL_ERROR "Native provenance requires a nonzero RVA and evidence purpose")
    endif()
    string(APPEND CDT_CONTEXT_ARRAYS "inline constexpr std::array<std::uint8_t, ${length}> ContextBytes${index}{${values}};\n")
    string(APPEND CDT_CONTEXT_ENTRIES "    ContextSignature{${rva}ULL, ContextBytes${index}},\n")
endforeach()
foreach(key innerOffset strideOffset countOffset resourceOffset commandHolderOffset nativeListOffset ownerBankIndexOffset)
    cdt_number(CDT_WRAPPER_${key} nativeCapture wrapper ${key})
endforeach()
foreach(key rootPointerOffset byteCount frameOffset screenOffset positionOffset directionOffset viewRelativeOffset earthRadiusOffset earthRadius)
    cdt_number(CDT_SCENE_${key} nativeCapture scene ${key})
endforeach()
foreach(key recordCount recordStride counterBytes validCounterByteOffset)
    cdt_number(CDT_GPU_${key} nativeCapture gpu ${key})
endforeach()
cdt_require(state STRING nativeCapture gpu resourceState)
if(NOT state STREQUAL "unordered-access")
    message(FATAL_ERROR "Native resource state differs from the reviewed post-dispatch copy contract")
endif()
set(CDT_SUPPORT_DECLARATIONS "")
set(CDT_SUPPORT_ENTRIES "")
set(CDT_RECOVERY_ANCHORS "")
set(CDT_SUPPORT_COUNT 0)
set(CDT_HAS_SUPPORT false)
string(JSON support_type ERROR_VARIABLE support_error TYPE "${cdt_profile}" nativeCapture support)
if(NOT support_error AND support_type STREQUAL "OBJECT")
    set(CDT_HAS_SUPPORT true)
endif()
foreach(key AmbientSourceOffset RendererGiOffset RendererSkyOffset RendererExposureOffset
    PhysicsCollectorVtableRva PhysicsQueryProfile UpstreamInputRva UpstreamBinderRva
    ExposureReturnRva)
    set(value 0)
    if(CDT_HAS_SUPPORT)
        cdt_number(value nativeCapture support values ${key})
    endif()
    string(APPEND CDT_SUPPORT_DECLARATIONS "inline constexpr std::uint32_t ${key} = ${value}U;\n")
endforeach()
if(CDT_HAS_SUPPORT)
    cdt_require(support_anchors ARRAY nativeCapture support anchors)
    string(JSON anchor_count LENGTH "${support_anchors}")
    set(CDT_SUPPORT_COUNT ${anchor_count})
    if(NOT anchor_count EQUAL 11)
        message(FATAL_ERROR "Full-product support needs all 11 bounded acquisition anchors")
    endif()
    foreach(index RANGE 0 10)
        cdt_require(name STRING nativeCapture support anchors ${index} name)
        if(NOT name MATCHES "^(AmbientHookA|AmbientHookB|AmbientSourceA|AmbientSourceB|SpatialDispatch|PhysicsShape|PhysicsRay|PhysicsCollectorMethod|ExposureDispatch|PhysicsShapeCaller|PhysicsRayCaller)$")
            message(FATAL_ERROR "Unknown acquisition anchor: ${name}")
        endif()
        cdt_number(rva nativeCapture support anchors ${index} rva)
        cdt_require(bytes STRING nativeCapture support anchors ${index} bytes)
        cdt_bytes(values length "${bytes}")
        cdt_require(recovery_pattern STRING nativeCapture support anchors ${index} relocationPattern)
        string(APPEND CDT_RECOVERY_ANCHORS "    RecoveryAnchor{\"${name}\", ${name}Rva, ${name}Bytes, \"${recovery_pattern}\"},\n")
        if(length LESS 12 OR rva EQUAL 0)
            message(FATAL_ERROR "Acquisition context needs a nonzero RVA and at least 12 guarded bytes")
        endif()
        string(APPEND CDT_SUPPORT_DECLARATIONS "inline constexpr std::uint64_t ${name}Rva = ${rva}ULL;\ninline constexpr std::array<std::uint8_t, ${length}> ${name}Bytes{${values}};\n")
        string(APPEND CDT_SUPPORT_ENTRIES "    ContextSignature{${name}Rva, ${name}Bytes},\n")
    endforeach()
else()
    foreach(name AmbientHookA AmbientHookB AmbientSourceA AmbientSourceB SpatialDispatch PhysicsShape PhysicsRay PhysicsCollectorMethod ExposureDispatch PhysicsShapeCaller PhysicsRayCaller)
        string(APPEND CDT_SUPPORT_DECLARATIONS "inline constexpr std::uint64_t ${name}Rva = 0;\n")
    endforeach()
    # Compatible array types keep preserved old-build branches reproducible.
    foreach(pair "AmbientHookA;15" "AmbientHookB;15" "SpatialDispatch;26" "PhysicsShape;30" "PhysicsRay;24")
        list(GET pair 0 name)
        list(GET pair 1 length)
        string(APPEND CDT_SUPPORT_DECLARATIONS "inline constexpr std::array<std::uint8_t, ${length}> ${name}Bytes{};\n")
    endforeach()
    foreach(name AmbientSourceA AmbientSourceB PhysicsCollectorMethod ExposureDispatch PhysicsShapeCaller PhysicsRayCaller)
        string(APPEND CDT_SUPPORT_DECLARATIONS "inline constexpr std::array<std::uint8_t, 0> ${name}Bytes{};\n")
    endforeach()
endif()
file(MAKE_DIRECTORY "${CMAKE_CURRENT_BINARY_DIR}/generated")
configure_file("${CMAKE_CURRENT_LIST_DIR}/native_contract.generated.h.in"
    "${CMAKE_CURRENT_BINARY_DIR}/generated/native_contract.generated.h" @ONLY)
string(REPLACE "inline constexpr" "inline" CDT_RUNTIME_CONTEXT_ARRAYS "${CDT_CONTEXT_ARRAYS}")
string(REPLACE "inline constexpr" "inline" CDT_RUNTIME_SUPPORT_DECLARATIONS "${CDT_SUPPORT_DECLARATIONS}")
configure_file("${CMAKE_CURRENT_LIST_DIR}/runtime_contract.generated.h.in"
    "${CMAKE_CURRENT_BINARY_DIR}/generated/runtime_contract.generated.h" @ONLY)
